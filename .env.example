# ============================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# Copiar este archivo como .env y completar los valores
# ============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=cambiar-esta-clave-por-una-aleatoria-larga
PORT=5000

# --- Base de datos ---
# Local (SQLite para desarrollo)
DATABASE_URL=sqlite:///DataBase/empresa.db

# Producción (PostgreSQL en Render)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# --- Email (Gmail) ---
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-contraseña-de-aplicacion

# --- Debug ---
DEBUG_MODE=false